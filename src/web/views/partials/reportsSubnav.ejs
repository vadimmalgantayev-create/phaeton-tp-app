<%# Переключатель между отчётами вкладки "Отчёты" (ТЗ PHA-88 Блок 2).
    `active` передаётся каждым report*.ejs ('clients' | 'brands'). Пунктов
    ровно столько, сколько отчётов уже реализовано на момент пуша -- 2.3
    "Дебиторская задолженность" добавится сюда своей отдельной задачей, а
    не заранее как мёртвая ссылка. %>
<div class="nav">
  <a href="/reports/clients" class="<%= active === 'clients' ? 'active' : '' %>">Продажи по клиентам</a>
  <a href="/reports/brands" class="<%= active === 'brands' ? 'active' : '' %>">Продажи по брендам</a>
</div>
