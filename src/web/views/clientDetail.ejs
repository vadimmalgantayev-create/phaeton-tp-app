<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0">
  <title><%= client.name %> — Phaeton ТП</title>
  <link rel="stylesheet" href="/styles.css">
  <link rel="manifest" href="/manifest.webmanifest">
</head>
<body>
  <div class="screen">
    <%- include('partials/nav', { user }) %>
    <div class="header">
      <h1><%= client.name %></h1>
    </div>

    <div class="card">
      <h2>Реквизиты</h2>
      <p class="empty-state">Код: <%= client.code || '—' %></p>
      <p class="empty-state">Менеджер: <%= client.manager ? client.manager.name : '—' %></p>
      <p class="empty-state">Маршрут: <%= client.route || '—' %></p>
      <% client.addresses.forEach(function(a) { %>
        <p class="empty-state">
          <%= a.isPrimary ? '★ ' : '' %><%= a.city %>, <%= a.deliveryAddress %>
          <% if (a.deliveryType) { %>(<%= a.deliveryType %>)<% } %>
          <% if (a.phone) { %>· <%= a.phone %><% } %>
        </p>
      <% }) %>
      <a class="weight-badge" href="/orders/new?clientId=<%= client.id %>">Оформить заказ</a>
      <a class="weight-badge" href="/clients/<%= client.id %>/notes">Заметки</a>
    </div>

    <div class="card">
      <h2>Скидки</h2>
      <% if (client.discounts.length === 0) { %>
        <p class="empty-state">Индивидуальных скидок не найдено</p>
      <% } %>
      <% client.discounts.forEach(function(d) { %>
        <div class="task-row">
          <div class="task-name"><%= d.brand %> <span class="task-target">индивидуальная<% if (d.validUntil) { %>, до <%= new Intl.DateTimeFormat('ru-RU').format(d.validUntil) %><% } %><% if (d.isExpired) { %> · <span class="attention-debt">истекла, не применяется</span><% } %></span></div>
          <div class="weight-badge"><%= d.percent %>%</div>
        </div>
      <% }) %>
    </div>

    <div class="card">
      <h2>Задолженность</h2>
      <% if (!client.debt) { %>
        <p class="empty-state">Данных по ДЗ нет</p>
      <% } else { %>
        <p class="empty-state">Общая ДЗ: <%= Math.round(client.debt.totalDebt).toLocaleString('ru-RU') %><% if (client.debt.limitAmount) { %> / лимит <%= Math.round(client.debt.limitAmount).toLocaleString('ru-RU') %><% } %></p>
        <% if (client.debt.isOverdue) { %><p class="attention-debt">Просрочено<% if (client.debt.nearestPaymentDate) { %>, ближайший платёж: <%= new Intl.DateTimeFormat('ru-RU').format(client.debt.nearestPaymentDate) %><% } %></p><% } %>
      <% } %>
      <% if (client.missingInvoices.length > 0) { %>
        <p class="attention-debt">Нет накладных: <%= client.missingInvoices.length %></p>
        <% client.missingInvoices.forEach(function(m) { %>
          <p class="empty-state"><%= m.orderRef %></p>
        <% }) %>
      <% } %>
    </div>

    <% const monthKey = function(d) { return d.getUTCFullYear() + '-' + String(d.getUTCMonth() + 1).padStart(2, '0'); }; %>
    <% const monthLabel = function(d) { return new Intl.DateTimeFormat('ru-RU', { month: 'long', year: 'numeric' }).format(d); }; %>
    <% const dynamicsParam = dynamics ? `dynamics=${dynamics}&` : ''; %>
    <% const monthParam = `month=${monthKey(month)}&`; %>

    <div class="card">
      <h2>Продажи по брендам</h2>
      <form method="get" action="/clients/<%= client.id %>" class="form">
        <% if (dynamics) { %><input type="hidden" name="dynamics" value="<%= dynamics %>"><% } %>
        <select class="form-input" name="month" onchange="this.form.submit()">
          <% availableMonths.forEach(function(m) { %>
            <option value="<%= monthKey(m) %>" <%= monthKey(m) === monthKey(month) ? 'selected' : '' %>><%= monthLabel(m) %></option>
          <% }) %>
        </select>
      </form>
      <div class="color-filter" style="margin-top:10px">
        <a class="color-filter-btn<%= !dynamics ? ' active' : '' %>" href="?<%= monthParam %>">Все</a>
        <a class="color-filter-btn<%= dynamics === 'up' ? ' active' : '' %>" href="?<%= monthParam %>dynamics=up">Прирост</a>
        <a class="color-filter-btn<%= dynamics === 'down' ? ' active' : '' %>" href="?<%= monthParam %>dynamics=down">Отставание</a>
      </div>

      <% if (!hasBase) { %>
        <p class="empty-state" style="margin-top:10px">Для <%= monthLabel(month) %> нет базы для сравнения (данные начинаются с января 2025) — показан только текущий месяц.</p>
      <% } %>

      <% if (brandRows.length === 0) { %>
        <p class="empty-state" style="margin-top:10px">Продаж за <%= monthLabel(month) %> не найдено</p>
      <% } else { %>
        <% brandRows.forEach(function(r) { %>
          <div class="report-row">
            <div class="task-row">
              <div class="task-name">
                <button type="button" class="report-toggle" data-url="/clients/<%= client.id %>/brands/expand?brand=<%= encodeURIComponent(r.brand) %>&<%= monthParam %>">▶</button>
                <%= r.brand %>
                <span class="task-target">
                  <%= Math.round(r.currentEur).toLocaleString('ru-RU') %> EUR
                  <% if (r.currentVolumeL !== null) { %> · <%= Math.round(r.currentVolumeL).toLocaleString('ru-RU') %> л<% } %>
                  <% if (hasBase) { %>
                    · <%= monthLabel(lastYearMonth) %>: <%= Math.round(r.lastYearEur).toLocaleString('ru-RU') %> EUR<% if (r.lastYearVolumeL !== null) { %> · <%= Math.round(r.lastYearVolumeL).toLocaleString('ru-RU') %> л<% } %>
                  <% } %>
                </span>
              </div>
              <% if (hasBase) { %>
                <div class="<%= r.direction === 'up' ? 'deviation-up' : r.direction === 'down' ? 'deviation-down' : '' %>">
                  <%= r.deviationEur >= 0 ? '+' : '' %><%= Math.round(r.deviationEur).toLocaleString('ru-RU') %> EUR
                  <span class="task-target">
                    <% if (r.isNew) { %>новый<% } else if (r.deviationPercent === null) { %>—<% } else { %><%= r.deviationPercent >= 0 ? '+' : '' %><%= Math.round(r.deviationPercent) %>%<% } %>
                  </span>
                </div>
              <% } %>
            </div>
            <div class="report-children" style="display:none"></div>
          </div>
        <% }) %>
      <% } %>
    </div>

    <div class="card">
      <h2>Выпавшие SKU</h2>
      <p class="empty-state">
        Регулярный SKU — закуп в ≥4 из последних 6 полных месяцев перед <%= monthLabel(month) %>, без закупа в этом месяце.
      </p>
      <% if (droppedRows.length === 0) { %>
        <p class="empty-state" style="margin-top:10px">Выпавших SKU не найдено</p>
      <% } else { %>
        <% droppedRows.forEach(function(d) { %>
          <div class="task-row">
            <div class="task-name">
              <%= d.sku %>
              <span class="task-target"><%= d.brand %> · <%= d.productGroup %> · закуп <%= d.monthsBought %>/6 · последний закуп: <%= monthLabel(d.lastMonth) %></span>
            </div>
            <div class="weight-badge"><%= Math.round(d.lossEur).toLocaleString('ru-RU') %> EUR</div>
          </div>
        <% }) %>
        <div class="task-row">
          <div class="task-name"><strong>Итого (показано <%= droppedRows.length %> из <%= droppedTotal %>)</strong></div>
          <div class="weight-badge"><%= Math.round(droppedTotalLoss).toLocaleString('ru-RU') %> EUR</div>
        </div>
        <% if (!droppedAll && droppedTotal > droppedRows.length) { %>
          <a class="weight-badge" style="display:inline-block;margin-top:10px" href="?<%= monthParam %><%= dynamicsParam %>droppedAll=1">Показать все выпавшие</a>
        <% } %>
      <% } %>
    </div>
  </div>

  <%- include('partials/reportExpandScript') %>
</body>
</html>
